<%- layout("/layouts/boiler.ejs") %>
<div class="page-header">
  <div><p class="eyebrow">Find your next stay</p><h1>Explore places to stay</h1></div>
  <p class="muted d-none d-md-block mb-1">Comfortable spaces, wherever you go.</p>
</div>
      <div id="filters">
        <div class="filter">
          <div><i class="fa-solid fa-fire"></i></div>
          <p>Trending </p>
        </div>

        <div class="filter">
          <div><i class="fa-solid fa-mountain"></i></div>
          <p>Mountains</p>
        </div>

        <div class="filter">
          <div><i class="fa-solid fa-house-chimney-user"></i></div>
          <p>Home Stay</p>
        </div>

        <div class="filter">
          <div><i class="fa-solid fa-people-roof"></i></div>
          <p>Room</p>
        </div>

        <div class="filter">
          <div><i class="fa-solid fa-caravan"></i></div>
          <p>CountrySide</p>
        </div>

        <div class="filter">
          <div><i class="fa-solid fa-martini-glass"></i></div>
          <p>Clubbing</p>
        </div>

  <div class="toggle">
  <div class="form-check form-switch">
  <input class="form-check-input" 
  type="checkbox" role="switch"
   id="flexSwitchCheckDefault">
  <label class="form-check-label" for="flexSwitchCheckDefault">Tax Price</label>
</div>
</div>


</div>



    <% if(data.length === 0){ %><div class="alert alert-light border">No stays are listed yet.</div><% } %>
    <div class="main-card">
   <% for(let value of data) { %>
    <div class="card">
  <% if(value.image && value.image.url){ %><img src="<%=value.image.url%>" class="card-img-top" alt="Photo of <%= value.title %>"><% } else { %><div class="card-img-top bg-light d-flex align-items-center justify-content-center" role="img" aria-label="No photo available">No photo available</div><% } %>
  <div class="card-body">
    <h5 class="card-title"><%= value.title%></h5>
    <p class="card-text"><%=value.description%></p>
    <p class="card-price">INR <span class="price-value" data-base-price="<%=value.price%>"><%=value.price%></span> <span class="tax-info" hidden>(incl. 3% GST)</span></p>
    <p class="card-location"><i class="fa-solid fa-location-dot me-1"></i><%=value.location%> </p>
    <a href="/listings/<%=value.id%>"  class="btn btn-primary">View stay <i class="fa-solid fa-arrow-right ms-1"></i></a>
  </div>
</div>
   <%} %>
   </div>
<script>
  let clicked=document.getElementById("flexSwitchCheckDefault");
  clicked.addEventListener("change",()=>{
     document.querySelectorAll(".card-price").forEach((price)=>{
       const amount = price.querySelector(".price-value");
       const taxInfo = price.querySelector(".tax-info");
       const basePrice = Number(amount.dataset.basePrice);
       amount.textContent = clicked.checked ? (basePrice * 1.03).toFixed(2) : basePrice;
       taxInfo.hidden = !clicked.checked;
     });
  })
</script>
