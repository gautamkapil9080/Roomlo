<%- layout("/layouts/boiler.ejs") %>
<style>
  #filters{
    display:flex;
    gap:1rem;
    margin-bottom:1rem;
  }
  .filter{
    text-align:center;
    margin-right:1rem;
    margin-top:1rem;
    opacity:0.7;
  }
  .filter:hover{
    text-align:center;
    margin-right:1rem;
    margin-top:1rem;
    opacity:1;
  }
  .tax-info{
    display:none;
  }
  .toggle{
    border:1px solid black;
    border-radius:1rem;
    height:3.5rem;
    padding:1rem;
    margin-left:3rem;
    display:flex;
    align-items:center;
  }

</style>
<body>
      <div id="filters">
        <div class="filter">
          <div><i class="fa-solid fa-fire"></i></div>
          <p>Trending </p>
        </div>

        <div class="filter">
          <div><i class="fa-solid fa-mountain"></i></div>
          <p>Mountains</p>
        </div>

        <div class="filter">
          <div><i class="fa-solid fa-house-chimney-user"></i></div>
          <p>Home Stay</p>
        </div>

        <div class="filter">
          <div><i class="fa-solid fa-people-roof"></i></div>
          <p>Room</p>
        </div>

        <div class="filter">
          <div><i class="fa-solid fa-caravan"></i></div>
          <p>CountrySide</p>
        </div>

        <div class="filter">
          <div><i class="fa-solid fa-martini-glass"></i></div>
          <p>Clubbing</p>
        </div>

  <div class="toggle">
  <div class="form-check form-switch">
  <input class="form-check-input" 
  type="checkbox" role="switch"
   id="flexSwitchCheckDefault">
  <label class="form-check-label" for="flexSwitchCheckDefault">Tax Price</label>
</div>
</div>


</div>



    <div class="main-card">
   <% for(let value of data) { %>
    <div class="card" style="width: 18rem;">
  <img src="<%=value.image.url%>" class="card-img-top" alt="...">
  <div class="card-body">
    <h5 class="card-title"><%= value.title%></h5>
    <p class="card-text"><%=value.description%></p>
    <p class="card-price">INR <nbsp></nbsp><%=value.price%> <i class="tax-info">+ 3% GST</i></p>
    <p class="card-location"><%=value.location%> </p>
    <a href="/listings/<%=value.id%>"  class="btn btn-primary">More to know </a>
  </div>
</div>
   <%} %>
   </div>
</body>

<script>
  let clicked=document.getElementById("flexSwitchCheckDefault");
  clicked.addEventListener("click",()=>{
     let taxInfo=document.getElementsByClassName("tax-info");
        for(info of  taxInfo){
          info.style.display="inline";
        }
  })
</script>


