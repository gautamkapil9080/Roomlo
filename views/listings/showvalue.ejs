<%- layout("/layouts/boiler.ejs") %>

<div class="whole-card">
<div class="card" style="width: 30rem; height:30rem ">
  <img class="card-img-top" src="<%=findValue.image%>" alt="Card image cap">
  <div class="card-body">
    <p class="card-text"> <%=findValue.title%></p>
    <p>NPR <nsbp></nsbp><%=findValue.price%></p>
    <p><%=findValue.location%></p>
    <p><%=findValue.description%></p>
  </div>
</div>


<div class="show-submmit">
    <form method="GET" action="/edit/<%=findValue._id %>">
        <button class="btn btn-dark">Edit this </button>
     </form>
     <form method="POST" action="/delete/<%=findValue._id%>?_method=DELETE">
    <button class="btn btn-dark" >Delete this!</button>
</form>


</div>
    
</div>

