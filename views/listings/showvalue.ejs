<%- layout("/layouts/boiler.ejs") %>

<div class="whole-card">
<div class="show-card">
  <% if(findValue.image && findValue.image.url){ %>
    <img class="card-img-top" src="<%= findValue.image.url %>" alt="Photo of <%= findValue.title %>">
  <% } else { %>
    <div class="card-img-top bg-light d-flex align-items-center justify-content-center" role="img" aria-label="No photo available">No photo available</div>
  <% } %>
  <div class="card-body">
    <p class="eyebrow">A Roomlo stay</p>
    <h1 class="card-title"><%= findValue.title %></h1>
    <p class="card-price">INR <%= findValue.price %> <span class="muted fw-normal">per night</span></p>
    <p class="card-location"><i class="fa-solid fa-location-dot me-1"></i><%= findValue.location %></p>

    <p class="card-text"><%= findValue.description %></p>

    
    <% if(!findValue.owner){ %>

        <p>Owned By: Roomlo</p>

    <% } else { %>

        <p>Owned By: <%= findValue.owner.username %></p>

    <% } %>

  </div>

</div>


<!-- SHOW EDIT/DELETE ONLY TO OWNER -->

<% if(currUser && findValue.owner && findValue.owner._id.equals(currUser._id)){ %>

<div class="show-submmit">

    <form method="GET" action="/listings/edit/<%= findValue._id %>"> 
        <button class="btn btn-dark">Edit this</button>
    </form>

    <form method="POST" action="/listings/delete/<%= findValue._id %>?_method=DELETE">
        <button class="btn btn-dark">Delete this!</button>
    </form>

    <br>

</div>

<% } %>

<% if(currUser){ %>
  <a class="btn btn-dark" href="/review/<%= findValue._id %>">Write a review</a>
<% } else { %>
  <a class="btn btn-dark" href="/user/login">Log in to review</a>
<% } %>


<div id="allReview">

  <h5>Guest reviews</h5>

  <% if(findValue.reviews.length === 0){ %><p>No reviews yet.</p><% } %>

  <% for(let value of findValue.reviews){ %>

      <p>
        <%= value.comment %>
        Rating : <%= value.rating %>
        <% if(value.author && value.author.username){ %> · by <%= value.author.username %><% } %>
      </p>

  <% } %>

</div>

</div>
