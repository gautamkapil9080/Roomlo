<%- layout("/layouts/boiler.ejs") %>

    <h3>Check it and correct the data</h3> 
    <form method="POST" action="/listings/submmiteditdata/<%= newValue._id %>?_method=PUT" class="needs-validation" novalidate>
        <div class="group">
            <label for="title">Title</label>
             <input name="listing[title]" value="<%=newValue.title%>" class="form-control" required>
               <div class="valid-feedback">
                    Title Look Good
                </div>
                <div class="invalid-feedback">
                    Title Need to add
                </div> <br>
        </div>
        
        <div class="group">
            <label for="description">Description</label>
            <input name="listing[description]" value="<%=newValue.description%>" class="form-control" required> 
              <div class="valid-feedback">
                        Good Feedback
                </div>
                <div class="invalid-feedback">
                        Title is not Looking Good
                </div>
                <br>
        </div>
    
    <div class="group">
            <label for="number">Price</label>
           <input type="number" value="<%=newValue.price%>" name="listing[price]" class="form-control" required
           enctype="multipart/form-data">
                  <div class="valid-feedback">
                    Number Good 
                </div>
                <div class="invalid-feedback">
                        Invalid Number 
                </div>
           <br>
    </div>

    <div class="group">
        <label for="Location">Locations</label>
         <input name="listing[location]" value="<%=newValue.location%>" class="form-control" required>
           <div class="valid-feedback">
                    Location Look Good
                </div>
                <div class="invalid-feedback">
                    Location Need to add
                </div>
                <br>
    </div>

    <div class="group">
        <label for="country">Country</label>
        <input name="listing[Country]" value="<%=newValue.country%>" class="form-control" required>
          <div class="valid-feedback">
                    Country  Look Good
                </div>
                <div class="invalid-feedback">
                    Country  Need to add
                </div><br>
    </div>

        <button>Submmit it!</button>
    </form>


