


<% if(locals.success && locals.success.length > 0){ %>

<div class="alert alert-success" role="alert">
    <%= locals.success %>
</div>

<% } %>


<% if(locals.error && locals.error.length > 0){ %>

<div class="alert alert-danger" role="alert">
    <%= locals.error %>
</div>

<% } %>


<% if(locals.err && locals.err.length > 0){ %>

<div class="alert alert-danger" role="alert">
    <%= locals.err %>
</div>

<% } %>