 <% if(success && success.length>0){ %>
<div class="alert alert-success" role="alert">
    <%=success%>
</div>
<%}%>

<% if(err.length>0){ %>
<div class="alert alert-danger" role="alert">
    <%=err%>
</div>
<%}%>


<% if(error.length>0){ %>
<div class="alert alert-danger" role="alert">
    <%=error%>
</div>
<%}%>

